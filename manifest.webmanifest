{
  "name": "Androide 27",
  "short_name": "Androide 27",
  "description": "Bandeja de capturas y orden del día, atendida por Mordejai Clonsio",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0B1524",
  "theme_color": "#0B1524",
  "lang": "es",
  "dir": "ltr",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "archivos",
          "accept": ["image/*", "audio/*", "video/*", "application/pdf", "text/plain"]
        }
      ]
    }
  }
}
